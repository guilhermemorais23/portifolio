---
import { type Lang, t, ui } from "../lib/i18n";
import { perfil } from "../data/perfil";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const paragrafos = perfil.sobre[lang];
---

<section class="section wrap reveal" id="sobre">
  <div class="sheet-ref">
    <span class="num">A—01</span>
    <h2>{t(ui.sections.about, lang)}</h2>
    <span class="rule"></span>
  </div>
  <div class="prose">
    {paragrafos.map((p) => <p>{p}</p>)}
  </div>
</section>
